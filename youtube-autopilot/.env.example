# Copy to .env and fill in. Never commit the real .env.

# Anthropic API key — script/title/description generation
# https://platform.claude.com/
ANTHROPIC_API_KEY=

# Stock footage keys — both free, both optional, either one is enough.
# Providers are tried in order (Pexels, then Pixabay); with neither key the
# pipeline falls back to generated background slides.
# Pexels:  https://www.pexels.com/api/
# Pixabay: https://pixabay.com/api/docs/ (key shown on that page when logged in)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ElevenLabs API key — premium voices (https://elevenlabs.io)
# Optional: only needed when a channel sets video.voice_provider: elevenlabs
ELEVENLABS_API_KEY=

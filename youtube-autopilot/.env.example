# Copy to .env and fill in. Never commit the real .env.

# Anthropic API key — script/title/description generation
# https://platform.claude.com/
ANTHROPIC_API_KEY=

# Pexels API key — free stock footage (https://www.pexels.com/api/)
# Optional: without it the pipeline falls back to generated background slides.
PEXELS_API_KEY=
